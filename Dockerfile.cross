ARG CROSS_BASE_IMAGE
FROM $CROSS_BASE_IMAGE

RUN dpkg --add-architecture armhf || true && \
    dpkg --add-architecture arm64 || true && \
    apt-get update && \
    apt-get install -y libclang-dev clang llvm-dev lld || true

# Fix Android NDK missing -lunwind linker error
RUN find / -name "libgcc.a" 2>/dev/null | while read f; do cp "$f" "$(dirname "$f")/libunwind.a"; done || true

# Force Android NDK to use ld.gold instead of ld.bfd to avoid 32-bit linker out of memory (OOM)
RUN find /android-ndk -name "arm-linux-androideabi-ld" 2>/dev/null | while read f; do \
      if [ -f "$(dirname "$f")/arm-linux-androideabi-ld.gold" ]; then \
        cp -f "$(dirname "$f")/arm-linux-androideabi-ld.gold" "$f"; \
      fi \
    done || true
