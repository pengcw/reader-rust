# Cross is used only for the Android targets (see Cross.toml).
# KOReader's Building_targets.md recommends Android NDK r23c. Use the same
# pinned NDK on both Android ABIs instead of cross's older bundled NDK r21d
# (whose armv7 clang driver crashes when linking some Rust cdylibs).
ARG CROSS_BASE_IMAGE
FROM $CROSS_BASE_IMAGE

RUN apt-get update && \
    apt-get install -y --no-install-recommends libclang-dev clang llvm-dev curl unzip && \
    rm -rf /var/lib/apt/lists/*

ARG CROSS_BASE_IMAGE
RUN if echo "$CROSS_BASE_IMAGE" | grep -Eq 'armv7-linux-androideabi|aarch64-linux-android'; then \
      curl --fail --location --retry 3 \
        'https://dl.google.com/android/repository/android-ndk-r23c-linux.zip' \
        -o /tmp/android-ndk-r23c-linux.zip && \
      unzip -q /tmp/android-ndk-r23c-linux.zip -d /opt && \
      rm /tmp/android-ndk-r23c-linux.zip; \
    fi

# API 21 is the oldest Android API compatible with the Rust ARMv7 target.
ENV CARGO_TARGET_ARMV7_LINUX_ANDROIDEABI_LINKER=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang \
    CC_armv7_linux_androideabi=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang \
    CXX_armv7_linux_androideabi=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang++ \
    AR_armv7_linux_androideabi=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar \
    CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android21-clang \
    CC_aarch64_linux_android=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android21-clang \
    CXX_aarch64_linux_android=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android21-clang++ \
    AR_aarch64_linux_android=/opt/android-ndk-r23c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar
