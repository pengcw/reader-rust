+/* Legado extension: property reads stay numeric; only member-call reads adapt. */
+static bool legado_is_string(JSValueConst value)
+{
+    return JS_IsString(value) ||
+        (JS_IsObject(value) && JS_VALUE_GET_OBJ(value)->class_id == JS_CLASS_STRING);
+}
+
+static JSValue legado_string_length(JSContext *ctx, JSValueConst this_val,
+                                    int argc, JSValueConst *argv)
+{
+    if (argc != 0 || !legado_is_string(this_val))
+        return JS_ThrowTypeError(ctx, "String.length() requires a string and no arguments");
+    return JS_GetProperty(ctx, this_val, JS_ATOM_length);
+}
+
+static JSValue legado_get_string_length(JSContext *ctx)
+{
+    if (JS_IsUndefined(ctx->legado_string_length)) {
+        JSValue method = JS_NewCFunction(ctx, legado_string_length, "length", 0);
+        if (JS_IsException(method))
+            return method;
+        ctx->legado_string_length = method;
+    }
+    return JS_DupValue(ctx, ctx->legado_string_length);
+}
+
+/* Call adapters are used only by compiled member calls, never property reads. */
+static bool legado_bool_atom(JSContext *ctx, JSAtom atom)
+{
+    char buf[16];
+    const char *name = JS_AtomGetStr(ctx, buf, sizeof(buf), atom);
+    return !strcmp(name, "isVip") || !strcmp(name, "isPay");
+}
+
+static bool legado_member_atom(JSContext *ctx, JSAtom atom)
+{
+    return atom == JS_ATOM_length || legado_bool_atom(ctx, atom);
+}
+
+/* Value is owned; preserve it unless an explicitly registered getter exists. */
+static JSValue legado_bool_member_call(JSContext *ctx, JSValueConst receiver,
+                                       JSAtom atom, JSValue value)
+{
+    JSValue java = JS_GetPropertyStr(ctx, ctx->global_obj, "java");
+    if (JS_IsException(java)) {
+        JS_FreeValue(ctx, value);
+        return java;
+    }
+    JSValue resolver = JS_IsObject(java)
+        ? JS_GetPropertyStr(ctx, java, "__readerResolveBoolGetter")
+        : JS_UNDEFINED;
+    JS_FreeValue(ctx, java);
+    if (JS_IsException(resolver)) {
+        JS_FreeValue(ctx, value);
+        return resolver;
+    }
+    if (!JS_IsFunction(ctx, resolver)) {
+        JS_FreeValue(ctx, resolver);
+        return value;
+    }
+    JSValue name = JS_AtomToString(ctx, atom);
+    if (JS_IsException(name)) {
+        JS_FreeValue(ctx, resolver);
+        JS_FreeValue(ctx, value);
+        return name;
+    }
+    JSValue args[3] = {JS_DupValue(ctx, receiver), name, JS_DupValue(ctx, value)};
+    JSValue method = JS_Call(ctx, resolver, JS_UNDEFINED, 3, args);
+    for (int i = 0; i < 3; i++)
+        JS_FreeValue(ctx, args[i]);
+    JS_FreeValue(ctx, resolver);
+    if (JS_IsException(method) || JS_IsFunction(ctx, method)) {
+        JS_FreeValue(ctx, value);
+        return method;
+    }
+    JS_FreeValue(ctx, method);
+    return value;
+}
